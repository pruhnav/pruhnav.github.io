---
// Section heading fonts for this page only (Latin subsets).
import '@fontsource/bricolage-grotesque/latin-800.css';
import '@fontsource/nanum-pen-script/latin-400.css';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/monoton/latin-400.css';
import '@fontsource/climate-crisis/latin-400.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import ThwipBanner from '../../components/ThwipBanner.astro';
import Section from '../../components/Section.astro';
import OnRepeat from '../../components/OnRepeat.astro';
import PostList from '../../components/PostList.astro';
import LogbookLink from '../../components/LogbookLink.astro';
import ThreadDivider from '../../components/ThreadDivider.astro';
import Footer from '../../components/Footer.astro';
import ThwipFooterArt from '../../components/ThwipFooterArt.astro';
import { getThoughts, sections, sectionOf } from '../../lib/thoughts';
import { site } from '../../lib/site';

const posts = await getThoughts();
// One page, one section per series, like the homepage, in the order set in src/lib/thoughts.ts.
// A section shows once it has a post or a blurb to introduce it; music always shows (the albums
// on repeat, with the music series under them). The Logbook always closes the page.
const filled = sections
  .map((section) => ({ ...section, posts: posts.filter((p) => sectionOf(p).id === section.id) }))
  .filter((s) => s.id === 'music' || s.posts.length > 0 || s.blurb);
const inMusic = filled.filter((s) => s.music);
const top = filled.filter((s) => !s.music);

// A silk thread with a spider on it divides every section; the spiders sit at different
// spots and walk at different paces so they don't line up.
const spots = [{ at: 72, pace: 15 }, { at: 26, pace: 18 }, { at: 58, pace: 16.5 }, { at: 38, pace: 19 }];
const spot = (i: number) => spots[i % spots.length];
---

<Base title={`thwip · ${site.name}`} description="Thoughts on stuff going on in my life and in the world." noindex>
  <Header simple overlay />
  <main class="wrap">
    <ThwipBanner />
    <div class="intro">
      <h1>thwi<span class="p">p<svg class="cobweb" viewBox="0 0 10 10" aria-hidden="true"><path d="M0 0L9.6 0M0 0L8.31 4.8M0 0L4.8 8.31M0 0L0 9.6M3.2 0Q2.39 0.64 2.77 1.6Q1.75 1.75 1.6 2.77Q0.64 2.39 0 3.2M6.2 0Q4.63 1.24 5.37 3.1Q3.39 3.39 3.1 5.37Q1.24 4.63 0 6.2M9.2 0Q6.87 1.84 7.97 4.6Q5.03 5.03 4.6 7.97Q1.84 6.87 0 9.2" /></svg></span></h1>
      <p>Thoughts on stuff going on in my life and in the world. You found the spider.</p>
      <p>
        This part of the site is about the Pranav behind the resume and the degree. You'll find my views on different
        parts of life, plus regular updates on whatever I'm going through. Odds are hardly anyone will read this, but if
        you ever make it here, let me know.
      </p>
    </div>
    {top.map((s, i) => (
      <>
        <ThreadDivider {...spot(i)} />
        <Section id={s.id} title={s.title} font={s.font} underline={s.underline}>
          {s.blurb && <p class="blurb">{s.blurb}</p>}
          {s.id === 'music' && <OnRepeat />}
          {s.id === 'music' &&
            inMusic.map((m) => (
              <Section id={m.id} title={m.title} font={m.font} underline={m.underline} sub>
                {m.blurb && <p class="blurb">{m.blurb}</p>}
                {m.posts.length > 0 && <PostList posts={m.posts} />}
              </Section>
            ))}
          {s.posts.length > 0 && <PostList posts={s.posts} />}
        </Section>
      </>
    ))}
    <ThreadDivider {...spot(top.length)} />
    <LogbookLink />
    {posts.length === 0 && <p class="empty mono">Nothing here yet.</p>}
  </main>
  <Footer cta={false}><ThwipFooterArt slot="art" /></Footer>
</Base>

<style>
  .intro { padding: 28px 0 0; display: grid; gap: 10px; }
  h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 34px;
    letter-spacing: .01em;
    line-height: 1;
  }
  /* A small corner cobweb inside the bowl of the p. Measured from Doto 900: the hole
     runs 0.097em to 0.4em across and sits 0.1em to 0.403em above the baseline. */
  .p { position: relative; }
  .cobweb {
    position: absolute;
    left: .097em;
    top: calc(.95em - .403em);
    width: .303em;
    height: .303em;
    overflow: visible;
  }
  .cobweb path { fill: none; stroke: currentColor; stroke-width: .7; stroke-linecap: round; opacity: .85; }
  .intro p { color: var(--muted); font-size: 14px; max-width: 60ch; }
  .blurb { color: var(--muted); font-size: 14px; margin: -8px 0 16px; max-width: 60ch; }
  .empty { margin-top: 32px; font-size: 13px; color: var(--faint); }
</style>
