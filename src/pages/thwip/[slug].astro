---
import { render, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import ThwipBanner from '../../components/ThwipBanner.astro';
import Footer from '../../components/Footer.astro';
import ThwipFooterArt from '../../components/ThwipFooterArt.astro';
import Spider from '../../components/Spider.astro';
import ListenRecords from '../../components/ListenRecords.astro';
import LyricCarousel from '../../components/LyricCarousel.astro';
import RecordCard from '../../components/RecordCard.astro';
import { getThoughts, sectionOf, formatDate, isoDate } from '../../lib/thoughts';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getThoughts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'thoughts'>;
}
const { post } = Astro.props;
const { Content } = await render(post);
const section = sectionOf(post);
// A small copy of the cover is plenty once it's blurred behind the lyric cards.
const art = post.data.cover ? await getImage({ src: post.data.cover, width: 240, format: 'webp' }) : undefined;
---

<Base title={`${post.data.title} · ${site.name}`} description={post.data.title} noindex>
  <Header simple overlay />
  <main class="wrap">
    <ThwipBanner />
    <article>
      <a class="back mono" href={`/thwip/#${section.id}`}><Spider size={14} />thwip / {section.title.toLowerCase()}</a>
      <div class="head">
        <div>
          <h1>{post.data.title}</h1>
          {post.data.subtitle && <p class="subtitle">{post.data.subtitle}</p>}
          {(post.data.date || post.data.tags.length > 0) && (
            <div class="meta">
              {post.data.date && <time class="mono" datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>}
              {post.data.tags.map((t) => <span class="chip">{t}</span>)}
            </div>
          )}
        </div>
        <ListenRecords spotify={post.data.spotify} appleMusic={post.data.appleMusic} />
      </div>
      <div class="prose" style={art ? `--art:url(${art.src})` : undefined}>
        <Content />
        {post.data.moreLines.length > 0 && (
          <>
            <p>More lines that I like from this song:</p>
            <LyricCarousel lines={post.data.moreLines} />
          </>
        )}
        {post.data.playlistsIntro && <p>{post.data.playlistsIntro}</p>}
      </div>
      {post.data.playlists.length > 0 && (
        <ul class="playlists">
          {post.data.playlists.map((p) => (
            <li>
              <RecordCard href={p.spotify} cover={p.cover} title={p.title} subtitle="Playlist" label={`${p.title}, a playlist on Spotify`} />
            </li>
          ))}
        </ul>
      )}
    </article>
  </main>
  <Footer cta={false}><ThwipFooterArt slot="art" /></Footer>
</Base>

<style>
  article { padding-top: 28px; }
  .back { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--faint); transition: color .2s var(--ease); }
  .back:hover { color: var(--text); }
  .head { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 20px; }
  h1 { font-size: 26px; font-weight: 600; line-height: 1.25; letter-spacing: -.01em; }
  .subtitle { margin-top: 4px; font-size: 15px; color: var(--muted); }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; margin-top: 10px; }
  time { font-size: 12px; color: var(--faint); }

  .prose { margin-top: 28px; font-size: 16px; line-height: 1.75; }
  .prose > :global(* + *) { margin-top: 1.1em; }
  .prose :global(h2), .prose :global(h3) { margin-top: 2em; font-size: 17px; font-weight: 600; line-height: 1.4; }
  .prose :global(a) { text-decoration: underline; text-decoration-color: var(--border-strong); text-underline-offset: 3px; transition: text-decoration-color .2s var(--ease); }
  .prose :global(a:hover) { text-decoration-color: currentColor; }
  /* A song link in the text, with the Spotify logo before its name. */
  .prose :global(a.listen) { white-space: nowrap; }
  .prose :global(a.listen svg) { display: inline-block; width: .85em; height: .85em; margin-right: .3em; vertical-align: -.08em; fill: #1ed760; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.3em; }
  .prose :global(li + li) { margin-top: .35em; }
  /* Quotes are lyric cards, like the lyrics view in Spotify and Apple Music: big bold
     lines over the song's cover art, blurred, darkened and slowly drifting. */
  .prose :global(blockquote) {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin: 28px 0;
    padding: 22px 26px 28px;
    border-radius: 16px;
    background: #4a2f55;
    color: #fff;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -.015em;
    text-shadow: 0 1px 14px rgba(0, 0, 0, .2);
  }
  .prose :global(blockquote)::before {
    content: '';
    position: absolute;
    inset: -35%;
    z-index: -1;
    background: var(--art) center / cover;
    filter: blur(44px) saturate(1.8) brightness(.55);
    animation: art-drift 16s ease-in-out infinite alternate;
  }
  @keyframes art-drift {
    from { transform: scale(1.05) rotate(0deg) translate(-3%, -2%); }
    to { transform: scale(1.2) rotate(10deg) translate(3%, 2%); }
  }
  .prose :global(blockquote p + p) { margin-top: .3em; }
  .prose :global(blockquote p:first-child)::before {
    content: 'Lyrics';
    display: block;
    margin-bottom: 10px;
    font-size: 13px;
    letter-spacing: 0;
    opacity: .7;
  }
  @media (max-width: 520px) {
    .prose :global(blockquote) { padding: 18px 18px 22px; font-size: 23px; }
  }
  .prose :global(code) { font-family: var(--font-mono); font-size: .88em; background: var(--surface-2); border: 1px solid var(--border); border-radius: 5px; padding: 1px 5px; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--border); margin: 2em 0; }
  .prose :global(img) { border-radius: var(--radius); border: 1px solid var(--border); }
  /* Playlists: three across, two on a phone; a lone playlist keeps the same card size. */
  .playlists { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 20px; margin-top: 20px; }
</style>
