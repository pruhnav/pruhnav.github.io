import EveningScene from './EveningScene.astro';
import ny1Ink from '../assets/thwip/ny1-brooklyn-bridge-ink.webp';
---

<EveningScene
  ink={ny1Ink}
  horizon={62}
  sun={{ x: 66, y: 56, size: 34 }}
  skyAbove={56}
  stars={{ count: 9, top: 3, bottom: 24, seed: 11 }}
/>
