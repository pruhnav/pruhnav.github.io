---
// "On repeat right now", the first part of Music on /thwip/: a row of album cards (cover in
// front of a vinyl record) that keeps drifting sideways and pauses while you look (hover,
// touch or keyboard focus). Each card opens the album on Spotify.
import Section from './Section.astro';
import RecordCard from './RecordCard.astro';
import { onRepeat } from '../data/albums';

// The list runs twice so the loop is seamless; the second copy is hidden from
// screen readers and the keyboard.
const loop = [...onRepeat, ...onRepeat];
---

<Section id="on-repeat" title="On repeat right now" font="grotesk" sub>
  <div class="marquee" style={`--dur:${onRepeat.length * 6.5}s`}>
    <ul class="track">
      {loop.map((a, i) => {
        const copy = i >= onRepeat.length;
        return (
          <li aria-hidden={copy ? 'true' : undefined}>
            <RecordCard
              href={a.spotify}
              cover={a.cover}
              title={a.title}
              subtitle={a.artist}
              label={`${a.title} by ${a.artist}, play on Spotify`}
              tabindex={copy ? -1 : undefined}
            />
          </li>
        );
      })}
    </ul>
  </div>
</Section>

<style>
  /* Room above and below for the shadows, and soft edges where cards slide in and out. */
  .marquee {
    --gap: 20px;
    overflow: hidden;
    padding: 12px 0 18px;
    margin: -12px 0 -18px;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 40px, #000 calc(100% - 40px), transparent);
    mask-image: linear-gradient(to right, transparent, #000 40px, #000 calc(100% - 40px), transparent);
  }
  .track {
    list-style: none;
    display: flex;
    gap: var(--gap);
    width: max-content;
    animation: drift var(--dur) linear infinite;
  }
  /* Moving left by exactly one copy of the list (half the track, plus half a gap) lands on the same picture. */
  @keyframes drift { to { transform: translateX(calc(-50% - var(--gap) / 2)); } }
  .marquee:hover .track, .marquee:focus-within .track, .marquee:active .track { animation-play-state: paused; }
  .track li { flex: none; width: 240px; }
  @media (max-width: 520px) {
    .track li { width: 210px; }
  }
  /* Without motion: a still row you can scroll yourself, without the repeat. */
  @media (prefers-reduced-motion: reduce) {
    .marquee { overflow-x: auto; -webkit-mask-image: none; mask-image: none; }
    .track li[aria-hidden] { display: none; }
  }
</style>
