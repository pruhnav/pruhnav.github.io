---
// A list of posts on /thwip/: date, title and subtitle, one row each. Undated posts are centered.
import type { CollectionEntry } from 'astro:content';
import { formatDate, isoDate } from '../lib/thoughts';

interface Props {
  posts: CollectionEntry<'thoughts'>[];
}
const { posts } = Astro.props;
---

<ul class="posts">
  {posts.map(({ id, data }) => (
    <li>
      <a href={`/thwip/${id}/`} class:list={{ pinned: !data.date }}>
        {data.date && <time class="mono" datetime={isoDate(data.date)}>{formatDate(data.date)}</time>}
        <span class="name">
          <span class="title">{data.title}</span>
          {data.subtitle && <span class="sub">{data.subtitle}</span>}
        </span>
        {(data.draft || data.tags.length > 0) && (
          <span class="tags">
            {data.draft && <span class="chip">draft</span>}
            {data.tags.map((t) => <span class="chip">{t}</span>)}
          </span>
        )}
      </a>
    </li>
  ))}
</ul>

<style>
  .posts { list-style: none; border-top: 1px solid var(--border); }
  .posts li { border-bottom: 1px solid var(--border); }
  .posts a { display: grid; grid-template-columns: 104px 1fr auto; gap: 12px; align-items: baseline; padding: 12px 0; }
  .posts a:hover .title { text-decoration: underline; text-underline-offset: 3px; }
  /* An undated post introduces its section, so it sits centered above the rest. */
  .posts a.pinned { grid-template-columns: 1fr; justify-items: center; text-align: center; }
  .pinned .name { justify-content: center; }
  time { font-size: 12px; color: var(--faint); }
  .name { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 8px; }
  .title { font-size: 15px; font-weight: 500; }
  .sub { font-size: 13px; color: var(--muted); }
  .tags { display: flex; gap: 5px; }
</style>
