---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Section from './Section.astro';

const roles = (await getCollection('experience', (r) => !r.data.hidden)).sort((a, b) => a.data.order - b.data.order);
const items = await Promise.all(roles.map(async (r) => ({ ...r, Content: (await render(r)).Content })));
---

<Section id="experience" title="Experience">
  <ul class="list">
    {items.map(({ data, body, Content }) => {
      // Roles with bullets or tags expand; a role with only a link shows it as a button instead.
      const hasMore = Boolean(body?.trim()) || data.tags.length > 0;
      const dates = data.start ? `${data.start} - ${data.end ?? 'Present'}` : '';
      const head = (
        <div class="row">
          <div class="logo" aria-hidden="true">
            {data.logo ? <Image src={data.logo} alt="" width={64} height={64} /> : <span class={data.mono.length === 1 ? "glyph" : undefined}>{data.mono}</span>}
          </div>
          <div class="main">
            <div class="l1">
              <span class="name">
                <span class="co">{data.company}</span>
                {data.remote && (
                  <span class="remote mono" tabindex="0" data-tip={data.remote} aria-label={`Remote, from ${data.remote}`}>Remote</span>
                )}
              </span>
              {dates && <span class="dt mono">{dates}</span>}
            </div>
            <div class="l2">
              <span class="ro">{data.role}</span>
              <span class="loc">{data.location}</span>
            </div>
          </div>
        </div>
      );
      return (
        <li>
          {hasMore ? (
            <details>
              <summary>
                {head}
                <span class="toggle mono" aria-hidden="true"></span>
              </summary>
              <div class="more">
                <div class="body"><Content /></div>
                {data.tags.length > 0 && (
                  <div class="tags">{data.tags.map((t) => <span class="chip">{t}</span>)}</div>
                )}
                {data.link && (
                  <a class="link-arrow" href={data.link.href} target="_blank" rel="noopener">{data.link.label} &#8599;</a>
                )}
              </div>
            </details>
          ) : (
            <div class="plain">
              {head}
              {data.link && (
                <a class="toggle btn-link mono" href={data.link.href} target="_blank" rel="noopener">{data.link.label} &#8599;</a>
              )}
            </div>
          )}
        </li>
      );
    })}
  </ul>
</Section>

<style>
  .list { list-style: none; border-top: 1px solid var(--border); }
  li { border-bottom: 1px solid var(--border); }
  summary { list-style: none; cursor: pointer; position: relative; }
  summary::-webkit-details-marker { display: none; }
  .row { display: flex; gap: 14px; padding: 16px 0; }
  /* Every row reserves the same right column so dates and locations line up. */
  details .row, .plain .row { padding-right: 84px; }
  .plain { position: relative; }
  .btn-link:hover { color: var(--text); border-color: var(--border-strong); }
  .logo {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    display: grid;
    place-items: center;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
  }
  .logo .glyph { font-size: 20px; line-height: 1; }
  .logo :global(img) { width: 100%; height: 100%; object-fit: contain; padding: 5px; }
  .main { flex: 1; min-width: 0; }
  .l1, .l2 { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .name { display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .co { font-weight: 600; font-size: 15px; }
  .remote {
    position: relative;
    font-size: 10.5px;
    color: var(--muted);
    border: 1px solid var(--border);
    background: var(--surface-2);
    border-radius: 999px;
    padding: 0 7px;
    line-height: 1.7;
    cursor: help;
  }
  .remote::after {
    content: attr(data-tip);
    position: absolute;
    left: 50%;
    bottom: calc(100% + 6px);
    transform: translate(-50%, 3px);
    white-space: nowrap;
    font-size: 11px;
    color: var(--bg);
    background: var(--text);
    border-radius: 6px;
    padding: 2px 8px;
    opacity: 0;
    pointer-events: none;
    transition: opacity .15s var(--ease), transform .15s var(--ease);
  }
  .remote:hover::after, .remote:focus-visible::after { opacity: 1; transform: translate(-50%, 0); }
  .dt { font-size: 12px; color: var(--faint); white-space: nowrap; }
  .ro { font-size: 13.5px; color: var(--muted); }
  .loc { font-size: 12px; color: var(--faint); white-space: nowrap; }
  .toggle {
    position: absolute;
    right: 0;
    top: 16px;
    font-size: 11.5px;
    color: var(--faint);
    border: 1px solid var(--border);
    border-radius: 6px;
    width: 70px;
    text-align: center;
    padding: 1px 0;
    transition: color .2s var(--ease), border-color .2s var(--ease);
  }
  summary .toggle::before { content: 'more'; }
  details[open] summary .toggle::before { content: 'less'; }
  summary:hover .toggle { color: var(--text); border-color: var(--border-strong); }
  summary:hover .co { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--border-strong); }
  .more { padding: 0 0 18px 50px; display: grid; gap: 12px; }
  .body :global(ul) { list-style: none; display: grid; gap: 7px; }
  .body :global(li) { border: 0; position: relative; padding-left: 14px; font-size: 13.5px; color: var(--muted); }
  .body :global(li)::before { content: ''; position: absolute; left: 2px; top: 9px; width: 4px; height: 4px; border-radius: 50%; background: var(--faint); }
  .body :global(strong) { color: var(--text); font-weight: 500; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  @media (max-width: 520px) {
    .l1, .l2 { flex-direction: column; gap: 0; }
    .dt { order: 2; margin-top: 2px; }
    details .row, .plain .row { padding-right: 72px; }
    .toggle { width: 62px; font-size: 11px; }
    .more { padding-left: 0; }
  }
</style>
