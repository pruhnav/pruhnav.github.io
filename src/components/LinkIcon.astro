---
// Small icon for where a link goes: the site's logo when we have one,
// a mail icon for email, and a globe for anything else.
import { linkIcon } from '../lib/link-icon';

interface Props { href: string; [attr: string]: unknown }
const { href, ...attrs } = Astro.props;
const brand = linkIcon(href);
const mail = href.startsWith('mailto:');
---

{brand ? (
  <svg class="link-icon" viewBox="0 0 24 24" aria-hidden="true" {...attrs}><path fill="currentColor" d={brand.path} /></svg>
) : (
  <svg class="link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" {...attrs}>
    {mail
      ? <><rect x="3" y="5" width="18" height="14" rx="2.5" /><path d="m3.5 7 8.5 6 8.5-6" /></>
      : <><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></>}
  </svg>
)}

<style>
  .link-icon { display: inline-block; width: 12px; height: 12px; flex: none; }
</style>
