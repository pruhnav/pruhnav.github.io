---
// An album or playlist as a cover in front of a vinyl record that peeks out to the right,
// like a song shared in an Instagram DM. Hovering slides the record out and spins it, and
// the card opens the link (Spotify). Used by "On repeat right now" and by posts' playlists.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  href: string;
  cover: ImageMetadata;
  title: string;
  subtitle: string;
  /** What a screen reader hears, e.g. "HABIBTI by Drake, play on Spotify". */
  label: string;
  /** -1 for a copy the keyboard should skip. */
  tabindex?: number;
}
const { href, cover, title, subtitle, label, tabindex } = Astro.props;
---

<a class="album" href={href} target="_blank" rel="noopener" tabindex={tabindex} aria-label={label}>
  <span class="vinyl" aria-hidden="true">
    <span class="disc"><Image class="label" src={cover} width={200} alt="" /></span>
  </span>
  <span class="cover">
    <Image src={cover} width={480} alt="" />
    <svg class="play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l13-7.5z" /></svg>
    <span class="meta">
      <span class="title">{title}</span>
      <span class="artist">{subtitle}</span>
    </span>
  </span>
</a>

<style>
  /* Cover on the left, record behind it showing about half its width on the right. */
  .album { position: relative; display: block; aspect-ratio: 3 / 2; border-radius: 12px; }

  .cover {
    position: absolute;
    z-index: 1;
    left: 0;
    top: 0;
    height: 100%;
    aspect-ratio: 1;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.35);
  }
  .cover :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 45%, rgba(0, 0, 0, 0.72));
  }
  .play {
    position: absolute;
    z-index: 1;
    left: 10px;
    top: 10px;
    width: 18px;
    height: 18px;
    fill: #fff;
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.5));
  }
  .meta {
    position: absolute;
    z-index: 1;
    left: 11px;
    right: 11px;
    bottom: 10px;
    display: grid;
    gap: 1px;
    color: #fff;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
  }
  .title { font-size: 13.5px; font-weight: 600; line-height: 1.25; }
  .artist { font-size: 12px; opacity: 0.85; }

  .vinyl {
    position: absolute;
    top: 2%;
    left: 34.7%;
    height: 96%;
    aspect-ratio: 1;
    border-radius: 50%;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(255, 255, 255, 0.07);
    transition: transform 0.5s var(--ease);
  }
  /* Grooves and the cover-art label turn; the light catching the record (::after) stays put. */
  .disc {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: repeating-radial-gradient(circle, #0b0b0c 0 2px, #19191b 2px 3.5px);
  }
  .disc :global(.label) { width: 38%; height: 38%; border-radius: 50%; object-fit: cover; }
  .disc::after {
    content: '';
    position: absolute;
    width: 4%;
    height: 4%;
    border-radius: 50%;
    background: var(--bg);
  }
  .vinyl::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(from 20deg, transparent 0 8%, rgba(255, 255, 255, 0.09) 14%, transparent 22% 56%, rgba(255, 255, 255, 0.07) 63%, transparent 72%);
    pointer-events: none;
  }

  .album:hover .vinyl, .album:focus-visible .vinyl { transform: translateX(7%); }
  .album:hover .disc, .album:focus-visible .disc { animation: spin 3.5s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>
