---
import { site, socials } from '../lib/site';
import LinkIcon from './LinkIcon.astro';
import Spider from './Spider.astro';

interface Props {
  /** The "open to roles" line and email; off for the personal pages. */
  cta?: boolean;
}
const { cta = true } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="wrap">
  <slot name="art" />
  {cta && (
    <div class="cta">
      <p>Open to ML and software engineering roles.</p>
      <a class="mail mono" href={`mailto:${site.email}`}><LinkIcon href={`mailto:${site.email}`} />{site.email}</a>
    </div>
  )}
  <div class="bottom">
    <span class="me">
      <span class="mono">&copy; {year} {site.name}</span>
      <a class="hidden-door" href="/thwip/" aria-label="Personal notes"><Spider /></a>
    </span>
    <nav aria-label="Elsewhere">
      {socials.map((s) => (
        <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d={s.icon} /></svg>
        </a>
      ))}
    </nav>
  </div>
</footer>

<style>
  footer { margin-top: 72px; }
  .cta { border-top: 1px solid var(--border); padding: 28px 0; display: grid; gap: 6px; }
  .cta p { color: var(--muted); font-size: 14px; }
  .mail { font-size: 15px; width: fit-content; display: inline-flex; align-items: center; gap: 7px; }
  .mail svg { width: 15px; height: 15px; }
  .mail:hover { text-decoration: underline; text-underline-offset: 4px; }
  .bottom { display: flex; justify-content: space-between; align-items: center; padding: 18px 0 40px; border-top: 1px solid var(--border); font-size: 12px; color: var(--faint); }
  nav { display: flex; gap: 14px; }
  nav a { color: var(--faint); transition: color .2s var(--ease); }
  nav a:hover { color: var(--text); }
  .me { display: inline-flex; align-items: center; }
  /* The only way into /thwip/: a faint spider right after the name, with a bigger tap area than it looks. */
  .hidden-door { margin: -8px -8px -8px -2px; padding: 8px; color: var(--faint); opacity: .35; transition: opacity .2s var(--ease), color .2s var(--ease); }
  .hidden-door:hover, .hidden-door:focus-visible { opacity: 1; color: var(--text); }
</style>
