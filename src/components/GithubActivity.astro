---
import Section from './Section.astro';
import { getContributions, type Day } from '../lib/contributions';
import { site } from '../lib/site';

const data = await getContributions(site.githubUser);

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
// Label the column where each new month starts, skipping any label that would
// sit within 3 columns of the previous one (they would overlap).
const monthOf = (week: (Day | null)[]) => {
  const first = week.find((d) => d !== null);
  return first ? new Date(first.date + 'T00:00:00Z').getUTCMonth() : -1;
};
let lastLabel = -Infinity;
const labels = data?.weeks.map((week, i) => {
  const month = monthOf(week);
  const isNew = i === 0 || month !== monthOf(data.weeks[i - 1]);
  if (!isNew || month < 0 || i - lastLabel < 4 || i > data.weeks.length - 3) return '';
  lastLabel = i;
  return MONTHS[month];
});
---

{data && (
  <Section id="activity" title="GitHub" note={`${data.total.toLocaleString('en-US')} contributions this year`}>
    <a class="box" href={`https://github.com/${site.githubUser}`} target="_blank" rel="noopener" aria-label={`${data.total} GitHub contributions in the last year. Open GitHub profile.`}>
      <div class="scroll">
        <div class="cal" style={`--weeks:${data.weeks.length}`}>
          <div class="months" aria-hidden="true">
            {labels!.map((m) => <span>{m}</span>)}
          </div>
          <div class="cells" aria-hidden="true">
            {data.weeks.map((week) => (
              <div class="week">
                {Array.from({ length: 7 }, (_, i) => week[i] ?? null).map((d) =>
                  d ? <span class={`c l${d.level}`} title={`${d.count} on ${d.date}`} /> : <span class="c empty" />
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="legend mono" aria-hidden="true">
        <span>@{site.githubUser}</span>
        <span class="scale">Less <i class="c l0" /><i class="c l1" /><i class="c l2" /><i class="c l3" /><i class="c l4" /> More</span>
      </div>
    </a>
  </Section>
)}

<style>
  .box {
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 16px;
    transition: border-color .2s var(--ease);
  }
  .box:hover { border-color: var(--border-strong); }
  .scroll { overflow-x: auto; scrollbar-width: thin; }
  .cal { --cell: 10px; --gap: 2px; width: max-content; margin-left: auto; }
  .months, .cells { display: grid; grid-template-columns: repeat(var(--weeks), var(--cell)); gap: var(--gap); }
  .months { height: 16px; }
  .months span { font-family: var(--font-mono); font-size: 10px; color: var(--faint); white-space: nowrap; overflow: visible; }
  .week { display: grid; grid-template-rows: repeat(7, var(--cell)); gap: var(--gap); }
  .c { display: inline-block; width: var(--cell); height: var(--cell); border-radius: 2px; background: var(--heat-0); }
  .c.empty { background: transparent; }
  .l1 { background: var(--heat-1); }
  .l2 { background: var(--heat-2); }
  .l3 { background: var(--heat-3); }
  .l4 { background: var(--heat-4); }
  .legend { display: flex; justify-content: space-between; align-items: center; margin-top: 12px; font-size: 11px; color: var(--faint); }
  .scale { display: inline-flex; align-items: center; gap: 3px; }
  .scale .c { --cell: 10px; }
</style>
