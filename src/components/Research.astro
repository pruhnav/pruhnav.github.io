---
import { siIeee } from 'simple-icons';
import type { ImageMetadata } from 'astro';
import Section from './Section.astro';
import LinkIcon from './LinkIcon.astro';
import harvard from '../assets/logos/harvard-mark.png';
import pennState from '../assets/logos/penn-state-glyph.png';

type Paper = {
  venue: string;
  year: number;
  title: string;
  href: string;
  label: string;
  summary: string;
  /** Show the publisher's wordmark instead of an icon and label. viewBox crops the 24x24 icon to the mark. */
  logo?: { path: string; viewBox: string };
  /** More links after the paper, such as a talk or post about it. `mark` is a one-color logo (alpha mask) drawn in the link color. */
  extra?: { href: string; label: string; mark?: ImageMetadata }[];
};

const papers: Paper[] = [
  {
    venue: 'Springer CCIS (SEET)',
    year: 2026,
    title: 'VALS: A Model-Agnostic Virtual Reality Framework for Real-Time Annotation of 3D Anatomical Models',
    href: 'https://doi.org/10.1007/978-3-032-39763-8_24',
    label: 'Springer',
    summary:
      'A VR framework for Meta Quest 3 that lets anatomy instructors load any OBJ model and place, search, and save labeled pins in real time, fully on-device. Built in Unity 6 with OpenXR as a capstone with the Penn State College of Medicine.',
  },
  {
    venue: 'IEEE Data Descriptions',
    year: 2025,
    title: 'UniElecPrice: A Unified Cross-Regional Day-Ahead Electricity Price Dataset',
    href: 'https://ieeexplore.ieee.org/document/11169754',
    label: 'IEEE Xplore',
    logo: { path: siIeee.path, viewBox: '0 8.5 24 7' },
    extra: [
      {
        href: 'https://www.linkedin.com/posts/pranavbalachander2_last-weekend-i-presented-our-research-at-activity-7422450728159567873-IKEe',
        label: 'Harvard URC',
        mark: harvard,
      },
      {
        href: 'https://www.linkedin.com/feed/update/urn:li:activity:7386610525180207104/',
        label: 'ICDS Symposium',
        mark: pennState,
      },
    ],
    summary:
      'A globally unified dataset of day-ahead electricity prices from 40 markets across 5 continents, built for standardized forecasting research. Includes a hybrid CNN, BiLSTM, and attention model that outperformed LSTM and Transformer baselines.',
  },
];

const other = [
  {
    year: 2026,
    title: 'Assessing Tick-Borne Pathogen Transmission Risk in Pennsylvania',
    desc: 'ML and geospatial analysis to predict tick-borne pathogen presence and hotspots across Pennsylvania.',
    href: 'https://github.com/pruhnav/pa-tick-risk-mapping',
  },
  {
    year: 2025,
    title: 'Arctic Mercury Modeling',
    desc: 'ML-assisted modeling of mercury reduction, reemission, and diffusion across Arctic snow and ice.',
  },
];
---

<Section id="research" title="Research">
  <div class="list">
    {papers.map((paper) => (
      <article class="paper">
        <div class="meta mono">{paper.venue} &middot; {paper.year}</div>
        <h3><a href={paper.href} target="_blank" rel="noopener">{paper.title}</a></h3>
        <p>{paper.summary}</p>
        <div class="links">
          {paper.logo ? (
            <a class="link-arrow" href={paper.href} target="_blank" rel="noopener" aria-label={paper.label}>
              <svg class="wordmark" viewBox={paper.logo.viewBox} aria-hidden="true"><path fill="currentColor" d={paper.logo.path} /></svg>
            </a>
          ) : (
            <a class="link-arrow" href={paper.href} target="_blank" rel="noopener"><LinkIcon href={paper.href} />{paper.label}</a>
          )}
          {paper.extra?.map((l) => (
            <a class="link-arrow" href={l.href} target="_blank" rel="noopener">
              {l.mark ? (
                <span class="link-mark" aria-hidden="true" style={`--m:url(${l.mark.src});--ar:${l.mark.width / l.mark.height}`}></span>
              ) : (
                <LinkIcon href={l.href} />
              )}
              {l.label}
            </a>
          ))}
        </div>
      </article>
    ))}
  </div>
  <h3 class="sub mono">Pending publication</h3>
  <ul class="rest">
    {other.map((r) => {
      const inner = (
        <>
          <span class="yr mono">{r.year}</span>
          <span class="body">
            <span class="name">{r.title}</span>
            <span class="desc">{r.desc}</span>
          </span>
          <span class="arrow" aria-hidden="true">{r.href && <LinkIcon href={r.href} />}</span>
        </>
      );
      return <li>{r.href ? <a href={r.href} target="_blank" rel="noopener">{inner}</a> : <div>{inner}</div>}</li>;
    })}
  </ul>
</Section>

<style>
  .list { display: grid; gap: 12px; }
  .paper {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 20px;
    display: grid;
    gap: 10px;
    transition: border-color .2s var(--ease);
  }
  .paper:hover { border-color: var(--border-strong); }
  .meta { font-size: 12px; color: var(--faint); }
  h3 { font-size: 17px; font-weight: 600; line-height: 1.35; }
  h3 a:hover { text-decoration: underline; text-underline-offset: 3px; }
  p { font-size: 13.5px; color: var(--muted); }
  .links { display: flex; gap: 14px; }
  .wordmark { height: 13px; width: auto; aspect-ratio: 24 / 7; }
  .link-mark {
    display: inline-block;
    height: 13px;
    aspect-ratio: var(--ar);
    background: currentColor;
    -webkit-mask: var(--m) center / contain no-repeat;
    mask: var(--m) center / contain no-repeat;
  }

  .sub { font-size: 12px; font-weight: 400; color: var(--faint); margin: 32px 0 8px; text-transform: uppercase; letter-spacing: .06em; line-height: inherit; }
  .rest { list-style: none; border-top: 1px solid var(--border); }
  .rest li { border-bottom: 1px solid var(--border); }
  .rest a, .rest div { display: grid; grid-template-columns: 44px 1fr 16px; gap: 12px; align-items: baseline; padding: 11px 0; }
  .rest a:hover .name { text-decoration: underline; text-underline-offset: 3px; }
  .rest a:hover .arrow { color: var(--text); }
  .body { display: grid; gap: 2px; }
  .yr { font-size: 12px; color: var(--faint); }
  .name { font-size: 14px; font-weight: 500; }
  .desc { font-size: 13px; color: var(--muted); }
  .arrow { font-size: 12px; color: var(--faint); text-align: right; }
  .arrow svg { width: 13px; height: 13px; vertical-align: -2px; }
</style>
