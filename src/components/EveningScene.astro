---
// An ink sketch over an evening sky: a golden sunset in light mode, a deeper
// dusk in dark mode, with a few stars that fade in and out at dusk. The ink is
// an alpha mask, like the homepage banner, so it takes either sky. Sky colors
// are placed relative to the drawing's horizon, so any sketch lines up.
import type { ImageMetadata } from 'astro';

interface Props {
  ink: ImageMetadata;
  /** Horizon height, in percent of the drawing from its top. */
  horizon: number;
  /** Sun glow centre and diameter, in percent of the drawing. */
  sun: { x: number; y: number; size: number };
  /** A warm streak on the water below the sun. */
  glint?: boolean;
  /** Dusk stars: how many, the band they sit in (percent of the whole element from its top), x ranges to keep clear, and a seed so every build draws the same sky. */
  stars?: { count: number; top: number; bottom: number; avoid?: [number, number][]; seed: number };
  /** Extra sky above the drawing in px, e.g. to run behind a transparent header. */
  skyAbove?: number;
  /** Also fade into the page along the top edge, for art that sits below content. */
  fadeTop?: boolean;
  /** Keep the ground warmer at dusk, for scenes whose subject sits low in the frame. */
  litGround?: boolean;
}

const { ink, horizon, sun, glint = false, stars, skyAbove = 0, fadeTop = false, litGround = false } = Astro.props;

let seed = stars?.seed ?? 1;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const dots: { x: string; y: string; size: string; dur: string; delay: string }[] = [];
while (stars && dots.length < stars.count) {
  const x = 6 + rand() * 88;
  const y = stars.top + rand() * (stars.bottom - stars.top);
  const size = (1.4 + rand() * 0.9).toFixed(1);
  const dur = (5 + rand() * 5).toFixed(1);
  const delay = (-rand() * 10).toFixed(1);
  if (stars.avoid?.some(([from, to]) => x >= from && x <= to)) continue;
  dots.push({ x: x.toFixed(1), y: y.toFixed(1), size, dur, delay });
}
---

<div
  class:list={['evening', { 'fade-top': fadeTop, 'lit-ground': litGround }]}
  style={`--h:${horizon};--sky-above:${skyAbove}px;--ink-m:url(${ink.src})`}
  aria-hidden="true"
>
  <div class="scene" style={`aspect-ratio:${ink.width} / ${ink.height}`}>
    <span class="sun" style={`left:${sun.x}%;top:${sun.y}%;width:${sun.size}%`}></span>
    {glint && <span class="glint" style={`left:${sun.x}%;width:${sun.size * 0.3}%`}></span>}
    <span class="ink"></span>
  </div>
  {dots.length > 0 && (
    <div class="stars">
      {dots.map((s) => <i style={`left:${s.x}%;top:${s.y}%;--s:${s.size}px;--d:${s.dur}s;--delay:${s.delay}s`}></i>)}
    </div>
  )}
  <span class="edges"></span>
</div>

<style>
  /* Colors come from the --eve-* tokens in global.css, which follow the theme. */
  .evening {
    --c4: var(--eve-sky-4);
    --c5: var(--eve-sky-5);
    --stars: 1;

    position: relative;
    padding-top: var(--sky-above);
    overflow: hidden;
    background: var(--eve-sky-0);
    isolation: isolate;
  }
  .evening.lit-ground {
    --c4: var(--eve-ground-4);
    --c5: var(--eve-ground-5);
  }
  /* Stars only come out at dusk. */
  :global(:root[data-theme='light']) .evening { --stars: 0; }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme])) .evening { --stars: 0; }
  }

  .scene {
    position: relative;
    background: linear-gradient(
      var(--eve-sky-0) 0%,
      var(--eve-sky-1) calc(var(--h) * 0.52%),
      var(--eve-sky-2) calc(var(--h) * 0.87%),
      var(--eve-sky-3) calc(var(--h) * 1%),
      var(--c4) calc(var(--h) * 1% + 12%),
      var(--c5) 100%
    );
  }
  /* Low sun, just above the horizon. */
  .sun {
    position: absolute;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--eve-sun), transparent);
  }
  /* Its reflection: a tall, narrow glow running down the water from the horizon. */
  .glint {
    position: absolute;
    top: calc(var(--h) * 1% - 2%);
    height: 30%;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, var(--eve-glint), transparent);
  }
  .ink {
    position: absolute;
    inset: 0;
    background: var(--eve-ink);
    opacity: var(--eve-ink-a);
    -webkit-mask: var(--ink-m) center / 100% 100% no-repeat;
    mask: var(--ink-m) center / 100% 100% no-repeat;
  }

  /* Each star is dark most of its cycle, then glows briefly, out of step with the others. */
  .stars { position: absolute; inset: 0; opacity: var(--stars); }
  .stars i {
    position: absolute;
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    background: #fff4e2;
    box-shadow: 0 0 4px rgba(255, 244, 226, 0.6);
    opacity: 0;
    animation: blink var(--d) ease-in-out var(--delay) infinite;
  }
  @keyframes blink {
    0%, 35% { opacity: 0; }
    55% { opacity: 0.9; }
    75%, 100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .stars i { opacity: 0.5; }
  }

  /* No frame: it fades into the page at the sides and bottom, and the top when asked. */
  .edges {
    --edge: 32px;
    --top-fade: linear-gradient(transparent, transparent);
    position: absolute;
    inset: 0;
    background:
      var(--top-fade),
      linear-gradient(to right, var(--bg), transparent var(--edge), transparent calc(100% - var(--edge)), var(--bg)),
      linear-gradient(to top, var(--bg), transparent 48px);
  }
  .fade-top .edges { --top-fade: linear-gradient(to bottom, var(--bg), transparent 40px); }
  @media (max-width: 520px) {
    .edges { --edge: 18px; }
  }
</style>
