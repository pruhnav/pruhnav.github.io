---
// Ink sketches of places I've lived, drawn over a sky that follows the theme:
// daytime in light mode, a starry night in dark mode. The ink and skyline-fill
// layers are alpha masks, so the same drawing works in both themes.
import la1Ink from '../assets/banner/la1-panorama-ink.webp';
import la1Fill from '../assets/banner/la1-panorama-fill.webp';
import chn1Ink from '../assets/banner/chn1-chennai-central-ink.webp';
import chn1Fill from '../assets/banner/chn1-chennai-central-fill.webp';
import mnp4Ink from '../assets/banner/mnp4-edu-ink.webp';
import mnp4Fill from '../assets/banner/mnp4-edu-fill.webp';
import pa3Ink from '../assets/banner/pa3-harrisburg-ink.webp';
import pa3Fill from '../assets/banner/pa3-harrisburg-fill.webp';
import pa4Ink from '../assets/banner/pa4-state-college-ink.webp';
import pa4Fill from '../assets/banner/pa4-state-college-fill.webp';
import sf2Ink from '../assets/banner/sf2-embarcadero-ink.webp';
import sf2Fill from '../assets/banner/sf2-embarcadero-fill.webp';

// Cycle order follows where I've lived. mx/my place the sun or moon over the
// lowest stretch of skyline.
const places = [
  { name: 'Los Angeles, California', ink: la1Ink, fill: la1Fill, mx: 0.9, my: 0.26 },
  { name: 'Chennai, India', ink: chn1Ink, fill: chn1Fill, mx: 0.86, my: 0.28 },
  { name: 'Manipal, India', ink: mnp4Ink, fill: mnp4Fill, mx: 0.87, my: 0.17 },
  { name: 'Harrisburg, Pennsylvania', ink: pa3Ink, fill: pa3Fill, mx: 0.87, my: 0.24 },
  { name: 'State College, Pennsylvania', ink: pa4Ink, fill: pa4Fill, mx: 0.9, my: 0.22 },
  { name: 'San Francisco, California', ink: sf2Ink, fill: sf2Fill, mx: 0.57, my: 0.29 },
];

// Masks are pre-encoded WebP (lossy alpha), so they're used as-is rather than re-encoded.
const slides = places.map(({ name, ink, fill, mx, my }) => ({ name, ink: ink.src, fill: fill.src, mx, my }));

const vars = (s: (typeof slides)[number]) =>
  `--ink-m:url(${s.ink});--fill-m:url(${s.fill});--mx:${s.mx};--my:${s.my}`;

// Fixed star field (seeded so every build draws the same sky).
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const stars = Array.from({ length: 48 }, () => ({
  x: (1 + rand() * 98).toFixed(1),
  y: (2 + rand() * 50).toFixed(1),
  r: (0.5 + rand() * 0.7).toFixed(2),
  o: (0.35 + rand() * 0.65).toFixed(2),
  tw: rand() < 0.25,
}));
const first = slides[0];
// Server-rendered moon is full; the inline script swaps in today's phase.
const fullMoon = 'M0 -1A1 1 0 0 1 0 1A1 1 0 0 1 0 -1Z';
---

<div class="banner" id="top" data-banner data-slides={JSON.stringify(slides)}>
  <div class="sky" aria-hidden="true">
    <svg class="stars" width="100%" height="100%">
      {stars.map((s) => <circle class:list={{ tw: s.tw }} cx={`${s.x}%`} cy={`${s.y}%`} r={s.r} opacity={s.o} />)}
    </svg>
    <div class="meteors" data-meteors></div>
  </div>
  <div class="scene on" style={vars(first)} aria-hidden="true">
    <span class="orb"><svg class="moon" viewBox="-1 -1 2 2"><circle class="dark" r="1" /><path class="lit" d={fullMoon} /></svg></span><span class="fill"></span><span class="ink"></span>
  </div>
  <div class="scene" aria-hidden="true">
    <span class="orb"><svg class="moon" viewBox="-1 -1 2 2"><circle class="dark" r="1" /><path class="lit" d={fullMoon} /></svg></span><span class="fill"></span><span class="ink"></span>
  </div>
  <span class="edges" aria-hidden="true"></span>
  <button class="place mono" type="button" data-next aria-label={`Showing ${first.name}. Show the next place`}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.3" /></svg>
    <span data-name>{first.name}</span>
  </button>
</div>
<script is:inline>
  // Before first paint: draw today's moon phase, then pick a random place.
  (function () {
    var b = document.currentScript.previousElementSibling;

    // Moon phase (0 new, 0.5 full) from the mean synodic month, counted from
    // the new moon of 2000-01-06 18:14 UTC. Drawn with the lit side on the
    // right while waxing, as seen from the northern hemisphere.
    var phase = ((Date.now() - Date.UTC(2000, 0, 6, 18, 14)) / 864e5 / 29.530588853) % 1;
    if (phase < 0) phase += 1;
    var lit = (1 - Math.cos(2 * Math.PI * phase)) / 2;
    var rx = Math.abs(Math.cos(2 * Math.PI * phase)).toFixed(3);
    var waxing = phase < 0.5;
    var d = 'M0 -1A1 1 0 0 ' + (waxing ? 1 : 0) + ' 0 1A' + rx + ' 1 0 0 ' + (waxing !== lit < 0.5 ? 1 : 0) + ' 0 -1Z';
    b.querySelectorAll('.moon .lit').forEach(function (el) { el.setAttribute('d', d); });
    b.style.setProperty('--moon-lit', lit.toFixed(2));

    var slides = JSON.parse(b.getAttribute('data-slides'));
    var i = Math.floor(Math.random() * slides.length);
    b.setAttribute('data-index', String(i));
    if (i === 0) return;
    var s = slides[i];
    var scene = b.querySelector('.scene.on');
    scene.style.setProperty('--ink-m', 'url(' + s.ink + ')');
    scene.style.setProperty('--fill-m', 'url(' + s.fill + ')');
    scene.style.setProperty('--mx', s.mx);
    scene.style.setProperty('--my', s.my);
    b.querySelector('[data-name]').textContent = s.name;
    b.querySelector('[data-next]').setAttribute('aria-label', 'Showing ' + s.name + '. Show the next place');
  })();
</script>

<script>
  type Slide = { name: string; ink: string; fill: string; mx: number; my: number };

  const banner = document.querySelector<HTMLElement>('[data-banner]');
  if (banner) {
    const slides: Slide[] = JSON.parse(banner.dataset.slides ?? '[]');
    const scenes = banner.querySelectorAll<HTMLElement>('.scene');
    const button = banner.querySelector<HTMLButtonElement>('[data-next]')!;
    const name = banner.querySelector<HTMLElement>('[data-name]')!;
    let index = Number(banner.dataset.index ?? 0);
    let front = 0;
    let busy = false;

    const preload = (s: Slide) =>
      Promise.all(
        [s.ink, s.fill].map((src) => {
          const img = new Image();
          img.src = src;
          return img.decode().catch(() => {});
        }),
      );

    const apply = (el: HTMLElement, s: Slide) => {
      el.style.setProperty('--ink-m', `url(${s.ink})`);
      el.style.setProperty('--fill-m', `url(${s.fill})`);
      el.style.setProperty('--mx', String(s.mx));
      el.style.setProperty('--my', String(s.my));
    };

    const warmNext = () => preload(slides[(index + 1) % slides.length]);
    if ('requestIdleCallback' in window) requestIdleCallback(warmNext);
    else setTimeout(warmNext, 1500);

    const advance = async () => {
      if (busy) return;
      busy = true;
      const next = (index + 1) % slides.length;
      await preload(slides[next]);
      const back = scenes[1 - front];
      apply(back, slides[next]);
      back.classList.add('on');
      scenes[front].classList.remove('on');
      front = 1 - front;
      index = next;
      // Swap the caption halfway through the 0.6s crossfade so it matches the picture.
      window.setTimeout(() => (name.textContent = slides[next].name), reduceMotion.matches ? 0 : 300);
      button.setAttribute('aria-label', `Showing ${slides[next].name}. Show the next place`);
      busy = false;
      warmNext();
    };

    // Auto-advance every 5 seconds. Holds while the banner has keyboard focus or
    // the tab is in the background, and stays off for reduced-motion users.
    const INTERVAL = 5_000;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let focused = false;
    let timer: number | undefined;
    const schedule = () => {
      window.clearTimeout(timer);
      if (reduceMotion.matches) return;
      timer = window.setTimeout(async () => {
        if (!focused && !document.hidden) await advance();
        schedule();
      }, INTERVAL);
    };
    // Only keyboard focus holds it; a mouse click also focuses the button.
    banner.addEventListener('focusin', (e) => (focused = (e.target as Element).matches(':focus-visible')));
    banner.addEventListener('focusout', () => (focused = false));
    reduceMotion.addEventListener('change', schedule);

    button.addEventListener('click', async () => {
      await advance();
      schedule();
    });
    schedule();

    // Shooting stars, night sky only: one every 4 to 11 seconds, each with its
    // own start point, direction, length and speed. They live in the sky layer,
    // so the skyline fill hides them behind buildings.
    const meteors = banner.querySelector<HTMLElement>('[data-meteors]')!;
    const between = (lo: number, hi: number) => lo + Math.random() * (hi - lo);
    const isNight = () => getComputedStyle(banner).getPropertyValue('--stars').trim() === '1';
    const shoot = () => {
      const w = banner.clientWidth;
      const rightward = Math.random() < 0.5;
      const len = w * between(0.08, 0.14);
      const el = document.createElement('span');
      el.className = 'meteor';
      el.style.setProperty('--x', `${between(rightward ? 8 : 35, rightward ? 60 : 88)}%`);
      el.style.setProperty('--y', `${between(4, 30)}%`);
      el.style.setProperty('--angle', `${rightward ? between(18, 34) : between(146, 162)}deg`);
      el.style.setProperty('--len', `${len}px`);
      el.style.setProperty('--travel', `${len * between(1.6, 2.4)}px`);
      el.style.setProperty('--dur', `${between(0.7, 1.1)}s`);
      el.addEventListener('animationend', () => el.remove());
      meteors.append(el);
    };
    const queueMeteor = () => {
      window.setTimeout(() => {
        if (isNight() && !document.hidden && !reduceMotion.matches) shoot();
        queueMeteor();
      }, between(4000, 11000));
    };
    queueMeteor();
  }
</script>

<style>
  /* Night (dark mode) is the default, matching the site's tokens. */
  .banner {
    --sky-top: #060a18;
    --sky-bottom: #1a2446;
    --fill: linear-gradient(var(--sky-top), var(--sky-bottom));
    --ink: #c9d3ea;
    --ink-a: 0.9;
    --stars: 1;
    --orb-glow: rgba(246, 241, 220, 0.28);
    --orb-size: 7%;
    --disc: 1;
    --glow-o: calc(0.25 + 0.75 * var(--moon-lit, 1));

    /* No frame: it hangs from the header and fades into the page at the sides and bottom. */
    position: relative;
    aspect-ratio: 2.75 / 1;
    overflow: hidden;
    background: linear-gradient(var(--sky-top), var(--sky-bottom));
    isolation: isolate;
  }
  :global(:root[data-theme='light']) .banner {
    --sky-top: #b9d5ee;
    --sky-bottom: #f3efe7;
    --fill: rgba(255, 255, 255, 0.45);
    --ink: #27272a;
    --ink-a: 0.95;
    --stars: 0;
    --orb-glow: rgba(255, 228, 176, 0.75);
    --orb-size: 34%;
    --disc: 0;
    --glow-o: 1;
  }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme])) .banner {
      --sky-top: #b9d5ee;
      --sky-bottom: #f3efe7;
      --fill: rgba(255, 255, 255, 0.45);
      --ink: #27272a;
      --ink-a: 0.95;
      --stars: 0;
      --orb-glow: rgba(255, 228, 176, 0.75);
      --orb-size: 34%;
      --disc: 0;
      --glow-o: 1;
    }
  }

  .sky, .scene { position: absolute; inset: 0; }
  .stars { opacity: var(--stars); fill: #e8ecff; transition: opacity .4s var(--ease); }
  .stars .tw { animation: twinkle 4s ease-in-out infinite alternate; }
  .stars .tw:nth-child(3n) { animation-delay: -1.3s; }
  .stars .tw:nth-child(3n + 1) { animation-delay: -2.6s; }
  @keyframes twinkle { to { opacity: 0.15; } }

  .meteors { position: absolute; inset: 0; opacity: var(--stars); }
  .meteors :global(.meteor) {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--len);
    height: 1.5px;
    border-radius: 1px;
    background: linear-gradient(90deg, rgba(232, 236, 255, 0), rgba(232, 236, 255, 0.9));
    transform-origin: right center;
    opacity: 0;
    animation: meteor var(--dur) ease-out forwards;
  }
  .meteors :global(.meteor)::after {
    content: '';
    position: absolute;
    right: -1px;
    top: 50%;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 6px 1px rgba(232, 236, 255, 0.8);
    transform: translateY(-50%);
  }
  @keyframes meteor {
    0% { opacity: 0; transform: rotate(var(--angle)) translateX(0); }
    12% { opacity: 1; }
    70% { opacity: 1; }
    100% { opacity: 0; transform: rotate(var(--angle)) translateX(var(--travel)); }
  }

  .scene { opacity: 0; transition: opacity .6s var(--ease); }
  .scene.on { opacity: 1; }

  .fill, .ink {
    position: absolute;
    inset: 0;
    -webkit-mask: var(--fill-m) center / 100% 100% no-repeat;
    mask: var(--fill-m) center / 100% 100% no-repeat;
  }
  .fill { background: var(--fill); }
  .ink {
    background: var(--ink);
    opacity: var(--ink-a);
    -webkit-mask-image: var(--ink-m);
    mask-image: var(--ink-m);
  }

  /* Sun glow by day, moon by night, over the lowest part of the skyline. */
  .orb {
    position: absolute;
    left: calc(var(--mx) * 100%);
    top: calc(var(--my) * 100%);
    width: var(--orb-size);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
  }
  .orb::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--orb-glow), transparent);
    opacity: var(--glow-o);
  }
  /* Today's moon: a faint full disc with the lit part on top. */
  .moon {
    position: absolute;
    inset: 32%;
    width: 36%;
    height: 36%;
    overflow: visible;
    opacity: var(--disc);
    filter: drop-shadow(0 0 3px rgba(244, 239, 220, 0.45));
  }
  .moon .dark { fill: #f4efdc; opacity: 0.1; }
  .moon .lit { fill: #f4efdc; }

  .edges {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    --edge: 32px;
    background:
      linear-gradient(to right, var(--bg), transparent var(--edge), transparent calc(100% - var(--edge)), var(--bg)),
      linear-gradient(to top, var(--bg), transparent 48px);
  }

  .place {
    position: absolute;
    left: 10px;
    bottom: 10px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    max-width: calc(100% - 20px);
    font-size: 11.5px;
    color: var(--text);
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 2px 8px;
    transition: border-color .2s var(--ease);
  }
  .place:hover { border-color: var(--border-strong); }
  .place svg { width: 11px; height: 11px; flex: none; fill: none; stroke: currentColor; stroke-width: 2; }
  .place [data-name] { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  @media (max-width: 520px) {
    .place { left: 6px; bottom: 6px; font-size: 10.5px; padding: 1px 6px; }
    .edges { --edge: 18px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .scene { transition: none; }
    .stars .tw { animation: none; }
  }
</style>
