---
// Spider in the style of a Spider-Man chest emblem, drawn by hand in a 24x24 box.
interface Props {
  size?: number;
}
const { size = 16 } = Astro.props;
---

<svg class="spider" viewBox="0 0 24 24" width={size} height={size} aria-hidden="true">
  <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M10.8 9.4 7.2 5.4l1.2-3.8M13.2 9.4l3.6-4-1.2-3.8" />
    <path d="M10.6 10.6 4.6 8.6 2.4 3.6M13.4 10.6l6-2 2.2-5" />
    <path d="M10.6 12 4.6 14.4l-2.2 5.2M13.4 12l6 2.4 2.2 5.2" />
    <path d="M10.8 13.2 7.4 18l1 4.4M13.2 13.2l3.4 4.8-1 4.4" />
  </g>
  <g fill="currentColor">
    <circle cx="12" cy="6.9" r="1.7" />
    <path d="M12 8.7c2.1 0 2.9 2.6 2.5 4.6-.4 2.2-1.5 4.2-2.5 5.7-1-1.5-2.1-3.5-2.5-5.7-.4-2 .4-4.6 2.5-4.6Z" />
  </g>
</svg>
